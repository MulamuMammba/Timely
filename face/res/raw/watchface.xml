<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="ANALOG"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>
  <UserConfigurations>
    <ListConfiguration id="time" displayName="@string/cfg_time" defaultValue="analog">
      <ListOption id="analog" displayName="@string/opt_analog"/>
      <ListOption id="digital" displayName="@string/opt_digital"/>
    </ListConfiguration>
    <ListConfiguration id="hands" displayName="@string/cfg_hands" defaultValue="slim">
      <ListOption id="slim" displayName="@string/opt_slim"/>
      <ListOption id="tapered" displayName="@string/opt_tapered"/>
      <ListOption id="baton" displayName="@string/opt_baton"/>
    </ListConfiguration>
    <BooleanConfiguration id="seconds" displayName="@string/cfg_seconds" defaultValue="TRUE"/>
    <ListConfiguration id="font" displayName="@string/cfg_font" defaultValue="serif">
      <ListOption id="serif" displayName="@string/opt_serif"/>
      <ListOption id="sans" displayName="@string/opt_sans"/>
      <ListOption id="mono" displayName="@string/opt_mono"/>
    </ListConfiguration>
    <ColorConfiguration id="handColor" displayName="@string/cfg_color" defaultValue="linen">
      <ColorOption id="linen" displayName="@string/c_linen" colors="#FFECE7F5"/>
      <ColorOption id="lavender" displayName="@string/c_lavender" colors="#FFB7A3F0"/>
      <ColorOption id="gold" displayName="@string/c_gold" colors="#FFD8B25E"/>
    </ColorConfiguration>
  </UserConfigurations>
  <Scene backgroundColor="#FF000000">

    <ComplicationSlot x="0" y="0" width="450" height="450" slotId="0" supportedTypes="PHOTO_IMAGE" isCustomizable="TRUE" displayName="@string/slot_dial" alpha="255">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" primaryProvider="com.watchman.induetime/com.watchman.induetime.Dial" primaryProviderType="PHOTO_IMAGE"/>
      <BoundingOval x="0" y="0" width="450" height="450"/>
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="450">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]"/>
        </PartImage>
      </Complication>
      <Complication type="EMPTY">
        <PartText x="75" y="300" width="300" height="40">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="plexmono_light" size="17" color="#FFA69DBB">@string/hint_dial</Font>
          </Text>
        </PartText>
      </Complication>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
    </ComplicationSlot>

    <ComplicationSlot x="0" y="0" width="450" height="450" slotId="1" supportedTypes="PHOTO_IMAGE" isCustomizable="TRUE" displayName="@string/slot_aod" alpha="0">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" primaryProvider="com.watchman.induetime/com.watchman.induetime.Dial$Aod" primaryProviderType="PHOTO_IMAGE"/>
      <BoundingOval x="0" y="0" width="450" height="450"/>
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="450">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]"/>
        </PartImage>
      </Complication>
      <Complication type="EMPTY">
        <PartText x="75" y="300" width="300" height="40">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="plexmono_light" size="17" color="#FFA69DBB">@string/hint_dial</Font>
          </Text>
        </PartText>
      </Complication>
      <Variant mode="AMBIENT" target="alpha" value="255"/>
    </ComplicationSlot>
    <ListConfiguration id="time">
      <ListOption id="analog">
        <Group name="analog" x="0" y="0" width="450" height="450">
          <ListConfiguration id="hands">
              <ListOption id="slim">
                <AnalogClock x="0" y="0" width="450" height="450">
                  <HourHand resource="hour_slim" x="216" y="131" width="18" height="106" pivotX="0.5" pivotY="0.88679" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></HourHand>
                  <MinuteHand resource="min_slim" x="218" y="85" width="14" height="156" pivotX="0.5" pivotY="0.89744" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></MinuteHand>
                </AnalogClock>
              </ListOption>
              <ListOption id="tapered">
                <AnalogClock x="0" y="0" width="450" height="450">
                  <HourHand resource="hour_tapered" x="214" y="131" width="22" height="106" pivotX="0.5" pivotY="0.88679" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></HourHand>
                  <MinuteHand resource="min_tapered" x="216" y="85" width="18" height="156" pivotX="0.5" pivotY="0.89744" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></MinuteHand>
                </AnalogClock>
              </ListOption>
              <ListOption id="baton">
                <AnalogClock x="0" y="0" width="450" height="450">
                  <HourHand resource="hour_baton" x="214" y="131" width="22" height="106" pivotX="0.5" pivotY="0.88679" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></HourHand>
                  <MinuteHand resource="min_baton" x="216" y="85" width="18" height="156" pivotX="0.5" pivotY="0.89744" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="190"/></MinuteHand>
                </AnalogClock>
              </ListOption>
          </ListConfiguration>
          <BooleanConfiguration id="seconds">
            <BooleanOption id="TRUE">
              <AnalogClock x="0" y="0" width="450" height="450">
                <SecondHand resource="second" x="220" y="77" width="10" height="178" pivotX="0.5" pivotY="0.83146" tintColor="[CONFIGURATION.handColor.0]"><Variant mode="AMBIENT" target="alpha" value="0"/><Sweep frequency="SYNC_TO_DEVICE"/></SecondHand>
              </AnalogClock>
            </BooleanOption>
          </BooleanConfiguration>
          <PartImage x="216" y="216" width="18" height="18" tintColor="[CONFIGURATION.handColor.0]">
            <Image resource="cap"/>
          </PartImage>
        </Group>
      </ListOption>
      <ListOption id="digital">
        <Group name="digital" x="0" y="0" width="450" height="450">
          <ListConfiguration id="font">
              <ListOption id="serif">
                <DigitalClock x="45" y="160" width="360" height="120">
                  <Variant mode="AMBIENT" target="alpha" value="200"/>
                  <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="360" height="120">
                    <Font family="fraunces_light" size="104" color="[CONFIGURATION.handColor.0]"/>
                  </TimeText>
                </DigitalClock>
              </ListOption>
              <ListOption id="sans">
                <DigitalClock x="45" y="160" width="360" height="120">
                  <Variant mode="AMBIENT" target="alpha" value="200"/>
                  <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="360" height="120">
                    <Font family="figtree_light" size="96" color="[CONFIGURATION.handColor.0]"/>
                  </TimeText>
                </DigitalClock>
              </ListOption>
              <ListOption id="mono">
                <DigitalClock x="45" y="160" width="360" height="120">
                  <Variant mode="AMBIENT" target="alpha" value="200"/>
                  <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="360" height="120">
                    <Font family="plexmono_light" size="84" color="[CONFIGURATION.handColor.0]"/>
                  </TimeText>
                </DigitalClock>
              </ListOption>
          </ListConfiguration>
        </Group>
      </ListOption>
    </ListConfiguration>
  </Scene>
</WatchFace>
